@page "/search"
@rendermode InteractiveServer
@implements IDisposable
@inject ISearchService SearchService
@inject NavigationManager Navigation

<PageTitle>Search Conversations</PageTitle>

<div class="max-w-3xl mx-auto px-4 py-8">
    <h1 class="text-2xl font-bold mb-6">Search Conversations</h1>

    <div class="flex gap-2 mb-3">
        <input type="text"
               @bind="_query"
               @bind:event="oninput"
               @bind:after="OnQueryChanged"
               placeholder="@Placeholder"
               class="flex-1 rounded-lg border border-default-200 bg-default-50 px-3 py-2 text-sm focus:outline-none focus:border-primary"
               @onkeydown="HandleKeyDown" />
        <LumexButton Color="@ThemeColor.Primary"
                     IsDisabled="@(string.IsNullOrWhiteSpace(_query) || _isSearching)"
                     OnClick="RunSearch">
            Search
        </LumexButton>
    </div>

    <div class="flex items-center gap-3 mb-6">
        <LumexSwitch Value="_isKeywordSearch"
                     ValueChanged="OnSearchModeChanged"
                     Color="@ThemeColor.Primary"
                     Size="@Size.Small">
            Keyword search
        </LumexSwitch>
        <span class="text-xs text-default-400">@ModeHint</span>
    </div>

    @if (_isSearching)
    {
        <div class="flex justify-center py-8">
            <LumexSpinner Color="@ThemeColor.Primary" />
        </div>
    }
    else if (_hasSearched && _results.Count == 0)
    {
        <div class="text-center text-default-400 py-8">
            <p>No conversations found for "@_lastQuery".</p>
            @if (_lastSearchWasKeyword)
            {
                <p class="text-xs mt-1">Keyword search only matches the words you typed. Try fewer or different words, or switch it off to search by meaning.</p>
            }
            else
            {
                <p class="text-xs mt-1">Try a different query, switch on keyword search to look for an exact word, or make sure your conversations have been imported and embedded.</p>
            }
        </div>
    }
    else if (_results.Count > 0)
    {
        <p class="text-xs text-default-400 mb-3">@_results.Count result(s) for "@_lastQuery"</p>
        <div class="space-y-3">
            @foreach (var result in _results)
            {
                <button class="w-full text-left rounded-xl border border-default-200 hover:border-primary bg-white hover:bg-primary-50 transition-colors p-4"
                        @onclick="() => NavigateToConversation(result.ConversationId)">
                    <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0 flex-1">
                            <div class="font-medium text-sm truncate">@(result.Title ?? "Untitled")</div>
                            @if (!string.IsNullOrWhiteSpace(result.Summary))
                            {
                                <p class="text-xs text-default-500 mt-1 line-clamp-2">@result.Summary</p>
                            }
                            @if (result.Snippets is { Count: > 0 })
                            {
                                <div class="mt-2 space-y-1">
                                    @foreach (var snippet in result.Snippets)
                                    {
                                        <p class="text-xs text-default-500 border-l-2 border-default-200 pl-2">@snippet</p>
                                    }
                                </div>
                            }
                        </div>
                        @if (!_lastSearchWasKeyword)
                        {
                            @* Keyword ranks are relative to the top hit, not a similarity, so
                               showing them as a percentage would invite a false comparison. *@
                            <span class="text-xs text-default-400 shrink-0 mt-0.5">
                                relevance: @result.Score.ToString("P0")
                            </span>
                        }
                    </div>
                </button>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <LumexAlert Color="@ThemeColor.Danger" Title="Error" Class="mt-4">
            @_errorMessage
        </LumexAlert>
    }
</div>

@code {
    private string _query = string.Empty;
    private string _lastQuery = string.Empty;
    private bool _isSearching;
    private bool _hasSearched;
    private bool _isKeywordSearch;

    /// <summary>
    /// Mode the displayed results came from. Tracked separately from <c>_isKeywordSearch</c>
    /// so that flipping the toggle doesn't relabel results that are still on screen from the
    /// previous mode before the new search returns.
    /// </summary>
    private bool _lastSearchWasKeyword;
    private string _errorMessage = string.Empty;
    private readonly List<SearchResult> _results = [];
    private System.Threading.Timer? _debounceTimer;

    private string Placeholder => _isKeywordSearch
        ? "Words that must appear, e.g. NoClassDefFoundError"
        : "Search your conversation history...";

    private string ModeHint => _isKeywordSearch
        ? "Matching the exact words you type."
        : "Matching by meaning, not exact words.";

    /// <summary>
    /// Switches mode and immediately re-runs the current query, so the toggle reads as
    /// "show me these results the other way" rather than as a setting to apply by hand.
    /// </summary>
    private async Task OnSearchModeChanged(bool isKeywordSearch)
    {
        _isKeywordSearch = isKeywordSearch;

        if (!string.IsNullOrWhiteSpace(_query))
        {
            _debounceTimer?.Dispose();
            await RunSearch();
        }
    }

    private void OnQueryChanged()
    {
        // Debounce search-as-you-type
        _debounceTimer?.Dispose();
        if (string.IsNullOrWhiteSpace(_query)) return;
        _debounceTimer = new System.Threading.Timer(_ => InvokeAsync(RunSearch), null, 500, System.Threading.Timeout.Infinite);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_query) && !_isSearching)
        {
            _debounceTimer?.Dispose();
            await RunSearch();
        }
    }

    private async Task RunSearch()
    {
        var q = _query.Trim();
        if (string.IsNullOrEmpty(q) || _isSearching) return;

        _isSearching = true;
        _errorMessage = string.Empty;
        _results.Clear();
        StateHasChanged();

        try
        {
            var mode = _isKeywordSearch ? SearchMode.Keyword : SearchMode.Semantic;
            var searchResults = await SearchService.SearchAsync(q, limit: 20, mode);
            _results.AddRange(searchResults);
            _lastQuery = q;
            _lastSearchWasKeyword = _isKeywordSearch;
            _hasSearched = true;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Search failed: {ex.Message}";
        }
        finally
        {
            _isSearching = false;
            StateHasChanged();
        }
    }

    private void NavigateToConversation(string conversationId)
    {
        Navigation.NavigateTo($"/chat/conversation/{conversationId}");
    }

    public void Dispose()
    {
        _debounceTimer?.Dispose();
    }
}
