@page "/settings"
@using LumexUI.Shared.Icons
@rendermode InteractiveServer
@inject ISettingsService SettingsService
@inject IConversationService ConversationService

<PageTitle>Settings</PageTitle>

<div class="max-w-3xl mx-auto px-4 py-8">
    <h1 class="text-2xl font-bold mb-6">Settings</h1>

    @if (_isLoading)
    {
        <div class="flex justify-center py-12">
            <LumexSpinner Color="@ThemeColor.Primary" />
        </div>
    }
    else
    {
        <LumexTabs>
            <LumexTab Title="Prompt">
                @* System Prompt *@
                <section class="mb-8">
                    <div class="flex items-center justify-between mb-2">
                        <h2 class="text-lg font-semibold">System Prompt</h2>
                        <button class="text-xs text-default-400 hover:text-primary underline"
                                @onclick="ResetSystemPrompt"
                                title="Reset to default">
                            Reset to default
                        </button>
                    </div>
                    <p class="text-sm text-default-400 mb-3">
                        The system prompt is sent to the LLM on every chat request. It sets the assistant's persona and instructions.
                    </p>
                    <textarea @bind="_systemPrompt"
                            rows="8"
                            class="w-full rounded-lg border border-default-200 bg-default-50 px-3 py-2 text-sm focus:outline-none focus:border-primary font-mono"
                            placeholder="Enter system prompt..."></textarea>
                    @if (_isDefault)
                    {
                        <p class="text-xs text-default-400 mt-1">Using the default system prompt.</p>
                    }
                </section>

                @* User Profile *@
                <section class="mb-8">
                    <h2 class="text-lg font-semibold mb-2">User Profile</h2>
                    <p class="text-sm text-default-400 mb-3">
                        User profile information is imported from ChatGPT custom instructions and injected into every chat request as user context.
                        You can edit these fields to personalise how the assistant responds.
                    </p>

                    <div class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-default-700 mb-1">About me</label>
                            <textarea @bind="_userProfileText"
                                    rows="4"
                                    class="w-full rounded-lg border border-default-200 bg-default-50 px-3 py-2 text-sm focus:outline-none focus:border-primary"
                                    placeholder="e.g. I'm a software developer working with .NET and Azure..."></textarea>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-default-700 mb-1">How should the assistant respond?</label>
                            <textarea @bind="_userInstructions"
                                    rows="4"
                                    class="w-full rounded-lg border border-default-200 bg-default-50 px-3 py-2 text-sm focus:outline-none focus:border-primary"
                                    placeholder="e.g. Be concise and technical. Prefer code examples over prose explanations."></textarea>
                        </div>
                    </div>
                </section>

                @* Save button *@
                <div class="flex items-center gap-3">
                    <LumexButton Color="@ThemeColor.Primary"
                                IsDisabled="@_isSaving"
                                OnClick="SaveAll">
                        @(_isSaving ? "Saving..." : "Save Changes")
                    </LumexButton>

                    @if (!string.IsNullOrEmpty(_successMessage))
                    {
                        <span class="text-sm text-success-600">@_successMessage</span>
                    }
                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <span class="text-sm text-danger-600">@_errorMessage</span>
                    }
                </div>
            </LumexTab>
            <LumexTab Title="Conversations">
                @* Summaries (digests) *@
                <section class="mb-8">
                    <h2 class="text-lg font-semibold mb-2">Summaries</h2>
                    <p class="text-sm text-default-400 mb-3">
                        Generate a short digest for every conversation that doesn't have one, with the configured LLM. Each digest is
                        embedded as soon as it is written, so it improves search straight away. This makes one LLM call per conversation and
                        can take hours on a large library; it runs in the background and you'll be notified when it finishes.
                    </p>
                    <div class="flex items-center gap-3">
                        <LumexButton Variant="@Variant.Flat" OnClick="GenerateSummariesAsync" IsDisabled="@_summariesQueuing">
                            Generate summaries
                        </LumexButton>
                        @if (_summariesMessage is not null)
                        {
                            <span class="text-sm text-default-500">@_summariesMessage</span>
                        }
                    </div>
                </section>

                @* Embeddings *@
                <section class="mb-8">
                    <h2 class="text-lg font-semibold mb-2">Embeddings</h2>
                    <p class="text-sm text-default-400 mb-3">
                        Re-run embeddings across imported conversations. This regenerates vector embeddings
                        for conversations that have been summarised but not yet embedded.
                    </p>

                    @if (_embedStatus == EmbedStatus.Running)
                    {
                        <div class="border border-default-200 rounded-lg p-4 space-y-1">
                            <div class="flex items-center gap-2">
                                <LumexSpinner Size="@Size.Small" Color="@ThemeColor.Secondary" />
                                <span class="text-sm text-default-500">
                                    Embedding… @_embedded embedded@(_embeddingSkipped > 0 ? $", {_embeddingSkipped} skipped" : string.Empty)@(_embeddingErrors > 0 ? $", {_embeddingErrors} error(s)" : string.Empty)
                                </span>
                            </div>
                            <p class="text-xs text-default-400">You can leave this page — the run continues in the background.</p>
                        </div>
                    }
                    else
                    {
                        <LumexModal>
                            <LumexModalTrigger Variant="@Variant.Flat">Run embeddings</LumexModalTrigger>
                            <LumexModalContent>
                                <LumexModalHeader Class="flex-col gap-3">
                                    <div class="size-10 flex items-center justify-center bg-default-100 rounded-full">
                                        <RocketIcon Size="20" />
                                    </div>
                                    Embeddings
                                </LumexModalHeader>
                                <LumexModalBody>
                                    <p>
                                        Re-run embeddings across imported conversations. Conversations that
                                        previously failed to embed will be retried.
                                    </p>
                                </LumexModalBody>
                                <LumexModalFooter>
                                    <LumexButton FullWidth="@true"
                                                Color="@ThemeColor.Primary"
                                                Radius="@Radius.Full"
                                                OnClick="@(() => ConfirmRunEmbeddings(context))">
                                        Continue
                                    </LumexButton>
                                </LumexModalFooter>
                            </LumexModalContent>
                        </LumexModal>
                    }

                    @if (_embedStatus == EmbedStatus.Complete)
                    {
                        <LumexAlert Color="@EmbedResultColor" Title="@EmbedResultTitle" Class="mt-4">
                            @_embedded embedded, @_embeddingSkipped skipped, @_embeddingErrors failed.
                        </LumexAlert>
                    }
                    @if (_embedStatus == EmbedStatus.Failed)
                    {
                        <LumexAlert Color="@ThemeColor.Danger" Title="Embeddings failed" Class="mt-4">
                            @_embedErrorMessage
                        </LumexAlert>
                    }

                    @* Conversations that failed to embed — retried on the next run. *@
                    @if (_failedEmbeddings.Count > 0)
                    {
                        <div class="mt-4 border border-warning-200 rounded-lg p-4">
                            <p class="text-sm font-medium text-warning-600 mb-2">
                                @_failedEmbeddings.Count conversation(s) failed to embed
                            </p>
                            <p class="text-xs text-default-400 mb-2">
                                These are retried automatically the next time you run embeddings.
                            </p>
                            <ul class="list-disc list-inside space-y-0.5 text-sm text-default-600">
                                @foreach (var item in _failedEmbeddings)
                                {
                                    <li class="truncate" title="@item.Title">@(string.IsNullOrWhiteSpace(item.Title) ? item.ConversationId : item.Title)</li>
                                }
                            </ul>
                        </div>
                    }
                </section>
            </LumexTab>
            <LumexTab Title="Diagnostics">
                <section class="mb-8">
                    <div class="flex items-center justify-between mb-2">
                        <h2 class="text-lg font-semibold">Pipeline diagnostics</h2>
                        <button class="text-xs text-default-400 hover:text-primary underline"
                                @onclick="RefreshDiagnosticsAsync">
                            Refresh
                        </button>
                    </div>
                    <p class="text-sm text-default-400 mb-4">
                        Status of imported conversations as they move through summarisation, embedding,
                        and into the vector store.
                    </p>

                    @if (_diagLoading)
                    {
                        <div class="flex justify-center py-8">
                            <LumexSpinner Size="@Size.Small" Color="@ThemeColor.Primary" />
                        </div>
                    }
                    else if (_diagError is not null)
                    {
                        <LumexAlert Color="@ThemeColor.Danger" Title="Couldn't load diagnostics">@_diagError</LumexAlert>
                    }
                    else if (_summary is not null)
                    {
                        @* Summary cards *@
                        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-4">
                            <div class="border border-default-200 rounded-lg p-3">
                                <div class="text-2xl font-semibold">@_summary.TotalConversations</div>
                                <div class="text-xs text-default-400">Conversations</div>
                            </div>
                            <div class="border border-default-200 rounded-lg p-3">
                                <div class="text-2xl font-semibold">@(_summary.VectorPoints?.ToString() ?? "—")</div>
                                <div class="text-xs text-default-400">Vectors stored</div>
                            </div>
                            <div class="border border-default-200 rounded-lg p-3">
                                <div class="text-sm font-medium truncate" title="@_summary.LlmProvider">@(_summary.LlmProvider ?? "—")</div>
                                <div class="text-xs text-default-400 truncate" title="@(_summary.EmbeddingModelId ?? _summary.LlmModelId)">
                                    @(_summary.EmbeddingModelId ?? _summary.LlmModelId ?? "")
                                </div>
                            </div>
                            <div class="border border-default-200 rounded-lg p-3 col-span-2 sm:col-span-3">
                                <div class="text-sm font-medium">Chunking: @(_summary.ChunkingStrategy ?? "—")</div>
                                <div class="text-xs text-default-400">
                                    @if (_summary.ByChunkingStrategy is { Count: > 0 } strategies)
                                    {
                                        @("Embedded under " + string.Join(", ", strategies.Select(kv => $"{kv.Key} ({kv.Value})")))
                                    }
                                    else
                                    {
                                        @("Nothing embedded yet")
                                    }
                                </div>
                                <button class="mt-2 text-xs text-default-400 hover:text-primary underline disabled:opacity-40"
                                        disabled="@_reembedding" @onclick="ReembedAllAsync">
                                    Re-embed everything under @(_summary.ChunkingStrategy ?? "the configured strategy")
                                </button>
                                @if (_reembedMessage is not null)
                                {
                                    <div class="text-xs text-success-600 mt-1">@_reembedMessage</div>
                                }
                            </div>
                        </div>

                        @* Status breakdown *@
                        <div class="flex flex-wrap gap-2 mb-4">
                            @foreach (var kv in OrderedStatuses(_summary.ByStatus))
                            {
                                <span class="text-xs px-2 py-1 rounded-full @StatusClass(kv.Key)">@kv.Key: @kv.Value</span>
                            }
                        </div>

                        @* Derived issues / warnings *@
                        @if (_summary.Issues.Count > 0)
                        {
                            <div class="mb-4 space-y-1">
                                @foreach (var issue in _summary.Issues)
                                {
                                    <div class="text-sm text-warning-600 flex items-start gap-1.5">
                                        <span aria-hidden="true">⚠</span><span>@issue</span>
                                    </div>
                                }
                            </div>
                        }

                        @* Filters *@
                        <div class="flex flex-wrap items-center gap-2 mb-3">
                            <select @bind="_statusFilter" @bind:after="ApplyFilterAsync"
                                    class="rounded-lg border border-default-200 bg-default-50 px-2 py-1 text-sm">
                                <option value="">All statuses</option>
                                @foreach (var st in AllStatuses)
                                {
                                    <option value="@st">@st</option>
                                }
                            </select>
                            <input @bind="_search" @bind:after="ApplyFilterAsync" @bind:event="onchange"
                                   placeholder="Search title…"
                                   class="rounded-lg border border-default-200 bg-default-50 px-2 py-1 text-sm flex-1 min-w-[8rem]" />
                        </div>

                        @* Drill-down table *@
                        @if (_rows.Count == 0)
                        {
                            <p class="text-sm text-default-400 py-4">No conversations match.</p>
                        }
                        else
                        {
                            <div class="overflow-x-auto border border-default-200 rounded-lg">
                                <table class="w-full text-sm">
                                    <thead class="bg-default-100 text-default-500">
                                        <tr>
                                            <th class="text-left font-medium px-3 py-2">Title</th>
                                            <th class="text-left font-medium px-3 py-2">Status</th>
                                            <th class="text-center font-medium px-3 py-2">Summary</th>
                                            <th class="text-left font-medium px-3 py-2">Chunks</th>
                                            <th class="text-left font-medium px-3 py-2">Updated</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in _rows)
                                        {
                                            <tr class="border-t border-default-100">
                                                <td class="px-3 py-2 max-w-xs truncate" title="@(row.Title ?? row.ConversationId)">
                                                    @(string.IsNullOrWhiteSpace(row.Title) ? row.ConversationId : row.Title)
                                                </td>
                                                <td class="px-3 py-2">
                                                    <span class="text-xs px-2 py-0.5 rounded-full @StatusClass(row.Status)">@row.Status</span>
                                                </td>
                                                <td class="px-3 py-2 text-center">@(row.HasSummary ? "✓" : "–")</td>
                                                <td class="px-3 py-2 text-default-500" title="@(row.ChunkingStrategy ?? "No chunking strategy recorded")">
                                                    @(row.ChunkingStrategy is null ? "–" : $"{row.ChunkCount ?? 0} × {row.ChunkingStrategy}")
                                                </td>
                                                <td class="px-3 py-2 text-default-500">@FormatUnixDate(row.UpdateTime)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="flex items-center justify-between mt-3 text-sm">
                                <span class="text-default-400">@_diagTotal conversation(s)</span>
                                <div class="flex items-center gap-2">
                                    <button class="px-2 py-1 rounded border border-default-200 disabled:opacity-40"
                                            disabled="@(_page <= 1)" @onclick="PrevPageAsync">Prev</button>
                                    <span>Page @_page / @TotalPages</span>
                                    <button class="px-2 py-1 rounded border border-default-200 disabled:opacity-40"
                                            disabled="@(_page >= TotalPages)" @onclick="NextPageAsync">Next</button>
                                </div>
                            </div>
                        }
                    }
                </section>
            </LumexTab>
        </LumexTabs>
    }
</div>

@code {
    private bool _isLoading = true;
    private bool _isSaving;
    private string? _systemPrompt;
    private bool _isDefault;
    private string? _userProfileText;
    private string? _userInstructions;
    private string _successMessage = string.Empty;
    private string _errorMessage = string.Empty;

    // — Embeddings re-run —
    private enum EmbedStatus { Idle, Running, Complete, Failed }
    private EmbedStatus _embedStatus = EmbedStatus.Idle;
    private int _embedded;
    private int _embeddingErrors;
    private int _embeddingSkipped;
    private string? _embedJobId;
    private bool _isPolling;
    private string _embedErrorMessage = string.Empty;
    private IReadOnlyList<FailedEmbeddingItem> _failedEmbeddings = [];

    // A finished run is only a success when nothing failed. Partial failures are a warning; a run
    // where everything failed (nothing embedded or skipped) is a failure, not a completion.
    private bool _embedHadSuccess => _embedded > 0 || _embeddingSkipped > 0;
    private ThemeColor EmbedResultColor => _embeddingErrors == 0
        ? ThemeColor.Success
        : _embedHadSuccess ? ThemeColor.Warning : ThemeColor.Danger;
    private string EmbedResultTitle => _embeddingErrors == 0
        ? "Embeddings complete"
        : _embedHadSuccess ? "Embeddings completed with failures" : "Embeddings failed";

    protected override async Task OnInitializedAsync()
    {
        await LoadSettings();
        await ResumeEmbedStateAsync();
        await LoadDiagnosticsAsync();
    }

    private async Task LoadSettings()
    {
        _isLoading = true;
        _errorMessage = string.Empty;
        StateHasChanged();

        try
        {
            var promptTask = SettingsService.GetSystemPromptAsync();
            var profileTask = SettingsService.GetUserProfileAsync();
            await Task.WhenAll(promptTask, profileTask);

            var prompt = await promptTask;
            if (prompt is not null)
            {
                _systemPrompt = prompt.SystemPrompt;
                _isDefault = prompt.IsDefault;
            }

            var profile = await profileTask;
            if (profile is not null)
            {
                _userProfileText = profile.UserProfileText;
                _userInstructions = profile.UserInstructions;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load settings: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SaveAll()
    {
        _isSaving = true;
        _successMessage = string.Empty;
        _errorMessage = string.Empty;
        StateHasChanged();

        try
        {
            var promptTask = SettingsService.SaveSystemPromptAsync(_systemPrompt);
            var profileTask = SettingsService.SaveUserProfileAsync(_userProfileText, _userInstructions);
            await Task.WhenAll(promptTask, profileTask);

            _successMessage = "Settings saved successfully.";
            _isDefault = string.IsNullOrWhiteSpace(_systemPrompt);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error saving settings: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    /// <summary>
    /// On page load, reflect any embedding run that is in progress or recently finished so the
    /// user sees live status after navigating back, and show any conversations still failing.
    /// </summary>
    private async Task ResumeEmbedStateAsync()
    {
        try
        {
            var job = await ConversationService.GetLatestEmbedJobAsync();
            if (job is not null)
            {
                ApplyEmbedJob(job);
                if (job.EmbeddingStatus is "InProgress" or "NotStarted")
                {
                    _embedJobId = job.JobId;
                    _ = PollEmbedJobAsync(job.JobId);
                }
            }

            await RefreshFailedEmbeddingsAsync();
        }
        catch
        {
            // Resuming status is best-effort; failures here shouldn't break the settings page.
        }
    }

    private bool _summariesQueuing;
    private string? _summariesMessage;

    private async Task GenerateSummariesAsync()
    {
        _summariesQueuing = true;
        try
        {
            var response = await ConversationService.GenerateSummariesAsync();
            _summariesMessage = response switch
            {
                null => "Couldn't start generating summaries.",
                { AlreadyRunning: true } => "Summaries are already being generated.",
                _ => "Generating summaries in the background. You'll be notified when it finishes.",
            };
        }
        catch (Exception ex)
        {
            _summariesMessage = $"Couldn't start generating summaries: {ex.Message}";
        }
        finally
        {
            _summariesQueuing = false;
        }
    }

    private async Task ConfirmRunEmbeddings(LumexModal modal)
    {
        await modal.CloseAsync();
        await StartEmbeddingRun();
    }

    private async Task StartEmbeddingRun()
    {
        _embedStatus = EmbedStatus.Running;
        _embedded = _embeddingErrors = _embeddingSkipped = 0;
        _embedErrorMessage = string.Empty;
        StateHasChanged();

        try
        {
            var response = await ConversationService.RunEmbeddingsAsync();
            if (response?.JobId is null)
            {
                _embedStatus = EmbedStatus.Failed;
                _embedErrorMessage = "Failed to start embeddings: no job id returned from server.";
                return;
            }

            _embedJobId = response.JobId;
            await PollEmbedJobAsync(response.JobId);
        }
        catch (Exception ex)
        {
            _embedStatus = EmbedStatus.Failed;
            _embedErrorMessage = $"Error starting embeddings: {ex.Message}";
        }
    }

    /// <summary>
    /// Polls the embed job until its embedding phase reaches a terminal state, updating the live
    /// counts as it goes. The server keeps running even if the user navigates away.
    /// </summary>
    private async Task PollEmbedJobAsync(string jobId)
    {
        if (_isPolling) return;
        _isPolling = true;

        try
        {
            while (true)
            {
                await Task.Delay(2000);

                JobStatusResponse? job;
                try
                {
                    job = await ConversationService.GetJobStatusAsync(jobId);
                }
                catch
                {
                    // Transient polling error — retry on the next cycle.
                    continue;
                }

                if (job is null) continue;

                ApplyEmbedJob(job);
                StateHasChanged();

                if (job.EmbeddingStatus is "Complete" or "Failed")
                {
                    await RefreshFailedEmbeddingsAsync();
                    StateHasChanged();
                    break;
                }
            }
        }
        finally
        {
            _isPolling = false;
        }
    }

    /// <summary>Maps a polled job's embedding phase onto the page's status and counters.</summary>
    private void ApplyEmbedJob(JobStatusResponse job)
    {
        _embedded = job.EmbeddedConversations;
        _embeddingErrors = job.EmbeddingErrors;
        _embeddingSkipped = job.EmbeddingSkipped;

        _embedStatus = job.EmbeddingStatus switch
        {
            "InProgress" or "NotStarted" => EmbedStatus.Running,
            "Failed" => EmbedStatus.Failed,
            "Complete" => EmbedStatus.Complete,
            _ => _embedStatus,
        };

        if (job.EmbeddingStatus == "Failed")
            _embedErrorMessage = job.EmbeddingErrorMessage ?? "Embedding failed.";
    }

    private async Task RefreshFailedEmbeddingsAsync()
    {
        try
        {
            _failedEmbeddings = await ConversationService.GetFailedEmbeddingsAsync();
        }
        catch
        {
            // Non-fatal: leave the previously loaded list in place.
        }
    }

    // — Diagnostics —
    private bool _diagLoading = true;
    private string? _diagError;
    private DiagnosticsSummary? _summary;
    private IReadOnlyList<ConversationDiagnostic> _rows = [];
    private long _diagTotal;
    private int _page = 1;
    private const int DiagPageSize = 25;
    private string _statusFilter = string.Empty;
    private string _search = string.Empty;

    private static readonly string[] AllStatuses =
        ["Imported", "Summarised", "Embedded", "SummaryError", "EmbeddingError"];

    private int TotalPages => (int)Math.Max(1, Math.Ceiling(_diagTotal / (double)DiagPageSize));

    /// <summary>Loads the diagnostics summary and the first page of conversations. Best-effort.</summary>
    private async Task LoadDiagnosticsAsync()
    {
        _diagLoading = true;
        _diagError = null;
        StateHasChanged();
        try
        {
            _summary = await ConversationService.GetDiagnosticsAsync();
            await LoadDiagnosticPageAsync();
        }
        catch (Exception ex)
        {
            _diagError = ex.Message;
        }
        finally
        {
            _diagLoading = false;
        }
    }

    private async Task LoadDiagnosticPageAsync()
    {
        var resp = await ConversationService.GetDiagnosticConversationsAsync(
            string.IsNullOrEmpty(_statusFilter) ? null : _statusFilter,
            string.IsNullOrWhiteSpace(_search) ? null : _search,
            _page, DiagPageSize);
        _rows = resp?.Items ?? [];
        _diagTotal = resp?.Total ?? 0;
    }

    private async Task RefreshDiagnosticsAsync()
    {
        _page = 1;
        await LoadDiagnosticsAsync();
    }

    private bool _reembedding;
    private string? _reembedMessage;

    /// <summary>
    /// Rebuilds the whole corpus under the configured chunking strategy. The run itself happens in the
    /// background; this returns as soon as it is queued, and the diagnostics are reloaded so the strategy
    /// counts reflect the reset.
    /// </summary>
    private async Task ReembedAllAsync()
    {
        _reembedding = true;
        _reembedMessage = null;
        try
        {
            var queued = await ConversationService.ReembedAllAsync();
            _reembedMessage = queued is null
                ? null
                : $"Re-embedding {queued.ConversationsReset} conversation(s) and {queued.SessionsReset} session(s).";
            await LoadDiagnosticsAsync();
        }
        catch (Exception ex)
        {
            _diagError = ex.Message;
        }
        finally
        {
            _reembedding = false;
        }
    }

    private async Task ApplyFilterAsync()
    {
        _page = 1;
        await LoadDiagnosticPageAsync();
        StateHasChanged();
    }

    private async Task PrevPageAsync()
    {
        if (_page <= 1) return;
        _page--;
        await LoadDiagnosticPageAsync();
    }

    private async Task NextPageAsync()
    {
        if (_page >= TotalPages) return;
        _page++;
        await LoadDiagnosticPageAsync();
    }

    /// <summary>Known statuses first (in pipeline order), then any unexpected status the server returned.</summary>
    private static IEnumerable<KeyValuePair<string, long>> OrderedStatuses(Dictionary<string, long> byStatus)
        => AllStatuses.Where(byStatus.ContainsKey).Select(s => new KeyValuePair<string, long>(s, byStatus[s]))
            .Concat(byStatus.Where(kv => !AllStatuses.Contains(kv.Key)));

    private static string StatusClass(string status) => status switch
    {
        "Embedded"       => "bg-success-100 text-success-700",
        "Summarised"     => "bg-primary-100 text-primary-700",
        "Imported"       => "bg-default-100 text-default-600",
        "SummaryError"   => "bg-warning-100 text-warning-700",
        "EmbeddingError" => "bg-danger-100 text-danger-700",
        _                => "bg-default-100 text-default-600",
    };

    /// <summary>ChatGPT timestamps are Unix seconds (fractional). Render as a local date, or a dash.</summary>
    private static string FormatUnixDate(double? unixSeconds)
        => unixSeconds is { } s
            ? DateTimeOffset.FromUnixTimeMilliseconds((long)(s * 1000)).LocalDateTime.ToString("yyyy-MM-dd")
            : "—";

    private async Task ResetSystemPrompt()
    {
        try
        {
            var result = await SettingsService.ResetSystemPromptAsync();
            if (result is not null)
            {
                _systemPrompt = result.SystemPrompt;
                _isDefault = true;
                _successMessage = "System prompt reset to default.";
            }
            else
            {
                _errorMessage = "Error resetting system prompt: unexpected response from server.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error resetting system prompt: {ex.Message}";
        }
    }
}
